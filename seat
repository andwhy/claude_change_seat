#!/bin/zsh -f
# seat — переключение аккаунтов Claude Desktop без повторного входа.
#
# Всё, что привязано к аккаунту (куки, токены, чаты Code и Cowork, MCP-конфиг),
# Claude Desktop хранит в одной папке: ~/Library/Application Support/Claude.
# Релизная сборка не даёт подменить её переменной окружения, поэтому seat
# меняет папки местами, пока Claude закрыт: активный профиль лежит на
# стандартном пути, остальные ждут рядом в «Claude Profiles». Это переименование
# в пределах одного диска — мгновенно и без копирования.
# ~/.claude (настройки и история Claude Code) общий для всех профилей.

emulate -R zsh
setopt pipe_fail
PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH

# Переменные SEAT_* нужны только для тестов.
LIVE=${SEAT_LIVE_DIR:-$HOME/Library/Application Support/Claude}
STORE=${SEAT_STORE_DIR:-$HOME/Library/Application Support/Claude Profiles}
TRASH=${SEAT_TRASH_DIR:-$HOME/.Trash}
BUNDLE_ID=${SEAT_BUNDLE_ID:-com.anthropic.claudefordesktop}
APP=${SEAT_APP_NAME:-Claude}
MARKER=.seat-profile
SELF=${0:A}

usage() {
  cat <<'EOF'
seat — переключение аккаунтов Claude Desktop

  seat                        список профилей
  seat add <имя>              создать пустой профиль
  seat use <имя>              переключиться: Claude закроется и откроется с этим профилем
  seat rename <имя> <новое>   переименовать профиль
  seat rm <имя> [-y]          удалить профиль (в Корзину)
  seat current                имя активного профиля

До первого переключения текущие данные Claude считаются профилем «default».
В новом профиле нужно один раз войти в аккаунт, дальше seat переключает без входа.
EOF
}

say()  { print -r -- "$*"; }
fail() { print -ru2 -- "seat: $*"; return 1; }
die()  { fail "$@"; exit 1; }

check_name() {
  local re='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
  [[ $1 =~ $re ]] || die "недопустимое имя «$1»: латиница, цифры, «.», «_» и «-»"
}

ensure_store() { mkdir -p -m 700 -- "$STORE" || die "не удалось создать «$STORE»"; }

# Имя профиля, который сейчас лежит на стандартном пути. Папка без метки —
# это данные Claude до первого переключения, то есть «default».
active_name() {
  [[ -d $LIVE ]] || return 1
  local name=""
  [[ -f $LIVE/$MARKER ]] && name=$(<"$LIVE/$MARKER")
  name=${name//[[:space:]]/}
  say "${name:-default}"
}

parked_names() {
  local d
  for d in "$STORE"/*(N/); do say "${d:t}"; done
}

# PID главного процесса Claude, без хелперов. Флаг -a обязателен: по умолчанию
# pgrep пропускает своих предков, а seat может быть запущен изнутри Claude.
app_pids() {
  local pid
  for pid in $(pgrep -a -x "$APP"); do
    [[ $(ps -o comm= -p $pid) == */Contents/MacOS/$APP ]] && say $pid
  done
}

# Запущен ли seat из самого Claude, например из вкладки Code.
inside_app() {
  local -a pids=(${(f)"$(app_pids)"})
  (( ${#pids} )) || return 1
  local p=$$
  while (( p > 1 )); do
    (( ${pids[(Ie)$p]} )) && return 0
    p=$(ps -o ppid= -p $p) || return 1
    p=${p// /}
  done
  return 1
}

# Закрывает Claude сигналом SIGTERM: Electron обрабатывает его как обычный
# выход по Cmd+Q, с сохранением состояния. Но перехватывает он только первый
# SIGTERM, второй убивает процесс сразу. Поэтому PID, которым уже отправили
# сигнал, запоминаем и больше не трогаем.
quit_app() {
  local -a pids=(${(f)"$(app_pids)"})
  (( ${#pids} )) || return 0
  local sent=$STORE/.seat-signaled p i
  for p in $pids; do
    if grep -qx -- $p "$sent" 2>/dev/null; then
      fail "Claude уже получал команду выхода и не закрылся (возможно, ждёт ответа в диалоге). Закрой его через Cmd+Q и повтори."
      return 1
    fi
  done
  print -l -- $pids >>"$sent"
  say "Закрываю Claude…"
  kill -TERM $pids 2>/dev/null
  for (( i = 0; i < 240; i++ )); do
    [[ -z $(app_pids) ]] && { rm -f -- "$sent"; return 0; }
    sleep 0.25
  done
  fail "Claude не закрылся за минуту. Если он что-то спрашивает, ответь или закрой его через Cmd+Q, потом повтори."
}

# Хелперы Claude и всё, что запущено из папки профиля (например, сессии
# Claude Code). Пока они живы, папку трогать нельзя. Обработчик крэш-репортов
# живёт отдельно от приложения и может пережить его; ему переименование
# папки не мешает, поэтому его не ждём.
busy_procs() {
  ps -axo pid=,comm= | grep -F -e "/$APP.app/Contents/" -e "$LIVE/" | grep -v -F chrome_crashpad_handler
}

wait_quiet() {
  local i
  for (( i = 0; i < 240; i++ )); do
    [[ -z $(busy_procs) ]] && return 0
    sleep 0.25
  done
  fail "после закрытия Claude остались процессы, которые используют папку профиля:"$'\n'"$(busy_procs)"
}

# Кладёт активный профиль на полку и ставит на его место выбранный.
swap_to() {
  local target=$1 active=""
  if [[ -d $LIVE ]]; then
    active=$(active_name)
    if [[ -e $STORE/$active ]]; then
      fail "не могу убрать «$active»: «$STORE/$active» уже существует"
      return 1
    fi
    [[ -f $LIVE/$MARKER ]] || print -r -- $active >"$LIVE/$MARKER" || return 1
    mv -- "$LIVE" "$STORE/$active" || { fail "не удалось убрать профиль «$active»"; return 1; }
  fi
  # Если на стандартном пути уже есть папка, mv положил бы профиль внутрь неё.
  if [[ -e $LIVE ]] || ! mv -- "$STORE/$target" "$LIVE"; then
    if [[ -n $active && ! -e $LIVE ]] && mv -- "$STORE/$active" "$LIVE"; then
      fail "не удалось поставить профиль «$target», вернул «$active» на место"
    else
      fail "не удалось поставить профиль «$target»; проверь «$LIVE» и «$STORE»"
    fi
    return 1
  fi
}

launch_app() {
  open -b "$BUNDLE_ID" || { fail "не удалось запустить Claude"; return 1; }
  local i
  for (( i = 0; i < 80; i++ )); do
    [[ -n $(app_pids) ]] && return 0
    sleep 0.25
  done
  fail "Claude не запустился за 20 секунд, открой его вручную"
}

do_switch() {
  local target=$1 fresh=""
  [[ -e $STORE/$target/Cookies ]] || fresh=1
  quit_app || return 1
  # Не вышло поменять папки — открываем Claude с прежним профилем.
  if ! wait_quiet || ! swap_to $target; then
    launch_app
    return 1
  fi
  launch_app || return 1
  say "Готово: Claude открыт с профилем «$target»."
  [[ -n $fresh ]] && say "Профиль новый, войди в аккаунт. Дальше seat будет переключать без входа."
  return 0
}

# Изнутри Claude переключаться напрямую нельзя: закрывая Claude, seat убил бы
# сам себя. Поэтому работу доделывает отвязанный процесс в собственной сессии
# (setsid), а вывод уходит в лог.
switch_detached() {
  command -v perl >/dev/null || die "для переключения изнутри Claude нужен perl; запусти seat из обычного терминала"
  local log=$STORE/.seat.log
  nohup perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" __switch $1 </dev/null >>"$log" 2>&1 &!
  say "seat запущен изнутри Claude, поэтому переключаюсь в фоне: через пару секунд Claude закроется и откроется с профилем «$1»."
  say "Лог: $log"
}

cmd_list() {
  local active="" name running=""
  [[ -d $LIVE ]] && active=$(active_name)
  local -a names=(${(f)"$(parked_names)"})
  [[ -n $active ]] && names+=($active)
  if (( ! ${#names} )); then
    say "Профилей пока нет. Создать: seat add <имя>"
    return
  fi
  [[ -n $(app_pids) ]] && running=1
  for name in ${(ou)names}; do
    if [[ $name == "$active" ]]; then
      say "* $name  (активный${running:+, Claude запущен})"
    else
      say "  $name"
    fi
  done
}

cmd_add() {
  local name=${1:-}
  [[ -n $name ]] || die "укажи имя: seat add <имя>"
  check_name $name
  [[ $name == "$(active_name)" || -e $STORE/$name ]] && die "профиль «$name» уже есть"
  ensure_store
  mkdir -m 700 -- "$STORE/$name" && print -r -- $name >"$STORE/$name/$MARKER" || die "не удалось создать профиль «$name»"
  say "Профиль «$name» создан. Переключиться: seat use $name"
}

cmd_use() {
  local target=${1:-} active=""
  [[ -n $target ]] || die "укажи профиль: seat use <имя>"
  check_name $target
  [[ -d $LIVE ]] && active=$(active_name)
  if [[ $target == "$active" ]]; then
    if [[ -n $(app_pids) ]]; then
      say "Профиль «$target» уже активен."
    else
      launch_app || exit 1
      say "Claude открыт с профилем «$target»."
    fi
    return
  fi
  [[ -d $STORE/$target ]] || die "профиль «$target» не найден. Создать: seat add $target"
  [[ -n $active && -e $STORE/$active ]] && die "не могу убрать «$active»: «$STORE/$active» уже существует"
  ensure_store
  if inside_app; then
    switch_detached $target
  else
    do_switch $target || exit 1
  fi
}

cmd_rename() {
  local old=${1:-} new=${2:-} active=""
  [[ -n $old && -n $new ]] || die "использование: seat rename <имя> <новое>"
  check_name $old
  check_name $new
  [[ -d $LIVE ]] && active=$(active_name)
  [[ $new == "$active" || -e $STORE/$new ]] && die "профиль «$new» уже есть"
  if [[ $old == "$active" ]]; then
    print -r -- $new >"$LIVE/$MARKER" || die "не удалось переименовать"
  else
    [[ -d $STORE/$old ]] || die "профиль «$old» не найден"
    mv -- "$STORE/$old" "$STORE/$new" && print -r -- $new >"$STORE/$new/$MARKER" || die "не удалось переименовать"
  fi
  say "Профиль «$old» теперь называется «$new»."
}

cmd_rm() {
  local name=${1:-}
  [[ -n $name ]] || die "укажи профиль: seat rm <имя>"
  check_name $name
  [[ $name == "$(active_name)" ]] && die "«$name» сейчас активен, сначала переключись на другой профиль"
  [[ -d $STORE/$name ]] || die "профиль «$name» не найден"
  if [[ ${2:-} != -y ]]; then
    [[ -t 0 ]] || die "подтверди удаление флагом: seat rm $name -y"
    read -q "?Удалить профиль «$name» (переместить в Корзину)? [y/N] " || { print; die "отменено"; }
    print
  fi
  mv -- "$STORE/$name" "$TRASH/seat-$name-$(date +%Y%m%d-%H%M%S)" || die "не удалось переместить в Корзину"
  say "Профиль «$name» перемещён в Корзину."
}

cmd_current() {
  active_name || die "нет активного профиля"
}

main() {
  [[ -L $LIVE ]] && die "«$LIVE» — символическая ссылка, seat работает только с обычной папкой"
  local cmd=${1:-list}
  (( $# )) && shift
  case $cmd in
    list|ls)        cmd_list ;;
    add|new)        cmd_add "$@" ;;
    use|switch)     cmd_use "$@" ;;
    rename|mv)      cmd_rename "$@" ;;
    rm|remove)      cmd_rm "$@" ;;
    current)        cmd_current ;;
    help|-h|--help) usage ;;
    __switch)       # фоновая часть switch_detached
                    check_name ${1:-}
                    sleep 2
                    say "== $(date '+%F %T') → ${1}"
                    do_switch $1 || exit 1 ;;
    *)              usage >&2; exit 1 ;;
  esac
}

# При source (в тестах) только определяем функции.
[[ $ZSH_EVAL_CONTEXT == toplevel ]] && main "$@"
